# ─────────────────────────────────────────────
#  PROJECT ATLAS — Environment Configuration
#  Copy this file to .env and fill in values.
#  All third-party sources used are FREE/OPEN.
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# MongoDB Atlas — add your connection string here
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/atlas?retryWrites=true&w=majority
MONGODB_DB_NAME=atlas

# Redis (BullMQ + Cache) — local or Redis Cloud free tier
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis-cli -u redis://default:xLRpUgxnrPgas6v7eN2jT7RIVXSzhT9S@ambitious-unbeatable-air-60293.db.redis.io:19067
REDIS_TLS=false

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_64_chars_minimum
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret_64_chars
JWT_REFRESH_EXPIRES_IN=7d

# Encryption key for connector credentials stored at rest (AES-256)
ENCRYPTION_SECRET=change_me_32_char_hex_secret_key!!

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Connector Config (ALL FREE / NO PAID TIER REQUIRED) ─────

# GitHub API — free, works without a token (60 req/hr unauthenticated)
# With a free Personal Access Token: 5000 req/hr
# Create at: https://github.com/settings/tokens (no special scopes needed)
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_SEARCH_QUERY=market intelligence OR business opportunity OR pain point

# RSS Feeds — completely free, comma-separated URLs
# Defaults below: Hacker News + TechCrunch + Product Hunt
RSS_FEED_URLS=https://hnrss.org/frontpage,https://feeds.feedburner.com/TechCrunch,https://www.producthunt.com/feed,https://feeds.arstechnica.com/arstechnica/index

# Remotive Jobs API — 100% free, no API key required
# Docs: https://remotive.com/api/remote-jobs
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
REMOTIVE_CATEGORIES=software-dev,devops-sysadmin,data,product

# HackerNews (Algolia API) — 100% free, no API key required
# Docs: https://hn.algolia.com/api
HN_API_URL=https://hn.algolia.com/api/v1

# ─── Stub Connectors (disabled until credentials available) ──

# Upwork — OAuth 2.0 required (apply at https://www.upwork.com/developer)
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_ENABLED=false

# LinkedIn — restricted API (https://developer.linkedin.com)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ENABLED=false

# Freelancer — https://developers.freelancer.com
FREELANCER_CLIENT_ID=
FREELANCER_CLIENT_SECRET=
FREELANCER_ENABLED=false

# Product Hunt — https://api.producthunt.com/v2/docs (free Developer token)
PRODUCT_HUNT_API_TOKEN=
PRODUCT_HUNT_ENABLED=false

# Google Trends — unofficial, no key required
GOOGLE_TRENDS_ENABLED=false

# ─── Queue Configuration ─────────────────────
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=5000
DEAD_LETTER_QUEUE_NAME=atlas:dlq

# ─── Cache Configuration ─────────────────────
CACHE_TTL_SECONDS=300

# ─── Logging ─────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ─── Monitoring ──────────────────────────────
METRICS_ENABLED=true
